# Experimental Derby SQL bytecode support, tested separately with GraalVM CE 25.4.
# Combine with native-image.args; not part of the ordinary JVM build/start path.
# Runtime-defined SQL classes call engine methods static analysis cannot predict.
-H:+UnlockExperimentalVMOptions
-H:+RuntimeClassLoading
-H:Preserve=package=org.apache.derby.iapi.*,package=org.apache.derby.impl.sql.*
-H:-PreserveIncludesJNI
--initialize-at-run-time=org.apache.derby
# Nacos excludes Bolt from its dependencies and selects NacosGrpcRaftRpcFactory.
# GraalVM 25.4 otherwise tries to compile the unavailable optional Bolt provider.
-H:ServiceLoaderFeatureExcludeServiceProviders=com.alipay.sofa.jraft.rpc.impl.BoltRaftRpcFactory
