set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT_DIR=$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)

detect_platform() {
    os_name=$(uname -s | tr '[:upper:]' '[:lower:]')
    arch_name=$(uname -m | tr '[:upper:]' '[:lower:]')

    case "${os_name}" in
        linux*) os_key="linux" ;;
        darwin*) os_key="darwin" ;;
        msys*|mingw*|cygwin*) os_key="windows" ;;
        *) os_key="${os_name}" ;;
    esac

    case "${arch_name}" in
        amd64|x86_64) arch_key="x86_64" ;;
        arm64|aarch64) arch_key="aarch64" ;;
        *) arch_key="${arch_name}" ;;
    esac

    printf '%s-%s' "${os_key}" "${arch_key}"
}

PLATFORM_KEY="${SKILLSPECTOR_RUNTIME_PLATFORM:-$(detect_platform)}"
RUNTIME_DIR="${SKILLSPECTOR_RUNTIME_HOME:-${ROOT_DIR}/runtime/${PLATFORM_KEY}}"

for candidate in \
    "${RUNTIME_DIR}/python/bin/python3" \
    "${RUNTIME_DIR}/python/bin/python" \
    "${RUNTIME_DIR}/venv/bin/python3" \
    "${RUNTIME_DIR}/bin/python3"
do
    if [ -x "${candidate}" ]; then
        exec "${candidate}" -m skillspector.cli "$@"
    fi
done

echo "SkillSpector runtime unavailable: ${RUNTIME_DIR}" >&2
echo "Expected an embedded Python runtime for ${PLATFORM_KEY}." >&2
exit 127
