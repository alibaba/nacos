<assembly>
    <id>server-${project.version}-native-${nacos.native.classifier}</id>
    <includeBaseDirectory>true</includeBaseDirectory>
    <formats>
        <format>dir</format>
        <format>tar.gz</format>
        <format>zip</format>
    </formats>
    <fileSets>


        <fileSet>
            <includes>
                <include>conf/**</include>
            </includes>
        </fileSet>

        <fileSet>
            <includes>
                <include>bin/*</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>../bootstrap/target/native</directory>
            <outputDirectory>target/</outputDirectory>
            <includes>
                <include>nacos-server</include>
                <include>nacos-server.exe</include>
                <include>*.so</include>
                <include>*.dylib</include>
                <include>*.dll</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>../bootstrap/target/native</directory>
            <outputDirectory>target/</outputDirectory>
            <includes>
                <include>aot-manifest.properties</include>
                <include>build.properties</include>
            </includes>
        </fileSet>
    </fileSets>
    <files>
        <file>
            <source>LICENSE-BIN</source>
            <destName>LICENSE</destName>
        </file>
        <file>
            <source>NOTICE-BIN</source>
            <destName>NOTICE</destName>
        </file>
    </files>

</assembly>
