{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nacos:schema:ai:mcp:internal:v1:mcp-version-storage",
  "$comment": "Copyright 1999-2026 Alibaba Group Holding Ltd. Licensed under the Apache License, Version 2.0. This is an internal schema and not a public wire compatibility contract.",
  "title": "Nacos MCP Version Storage And Endpoint Projection Schema v1",
  "description": "Definition bundle for MCP Version storage pointers, Direct Endpoint storage extensions and downgrade projection metadata, Versionless Runtime Naming publications, and the one-way migration marker.",
  "x-status": "experimental",
  "x-visibility": "internal",
  "x-schema-version": 1,
  "x-identifiers": {
    "resourceType": "mcp",
    "versionStorageKeyFormat": "mcp-config-v1",
    "runtimeServiceComposer": "mcp-name-v1",
    "directSnapshotDigest": "sha256-mcp-direct-endpoints-v1"
  },
  "x-constants": {
    "configGroups": [
      "mcp-server",
      "mcp-tools",
      "mcp-resources"
    ],
    "runtimeNamingGroup": "mcp-endpoints",
    "runtimeCluster": "DEFAULT",
    "directProjectionMetadata": {
      "mark": "__nacos.ai.mcp.service__",
      "mcpId": "__nacos.ai.mcp.id__",
      "version": "__nacos.ai.mcp.version__",
      "endpointSnapshotHash": "__nacos.ai.mcp.endpointSnapshotHash__"
    },
    "runtimeMetadata": {
      "supportedTransports": "__nacos.mcp.endpoint.supportedTransports__",
      "version": "__nacos.mcp.endpoint.version__",
      "versionRange": "__nacos.mcp.endpoint.versionRange__",
      "legacyVersion": "_mcp_server_version"
    },
    "migrationMarker": {
      "group": "nacos_internal",
      "dataId": "nacos.ai.mcp.resource.migration.v1"
    },
    "migrationLease": {
      "group": "nacos_internal",
      "dataId": "nacos.ai.mcp.resource.migration.lock.v1"
    }
  },
  "x-entrypoints": {
    "McpVersionStorageDescriptor": "#/$defs/McpVersionStorageDescriptor",
    "McpServerStorageExtension": "#/$defs/McpServerStorageExtension",
    "McpDirectEndpoint": "#/$defs/McpDirectEndpoint",
    "McpDirectEndpointSnapshot": "#/$defs/McpDirectEndpointSnapshot",
    "McpDirectProjectionMetadata": "#/$defs/McpDirectProjectionMetadata",
    "McpRuntimeEndpointMetadata": "#/$defs/McpRuntimeEndpointMetadata",
    "McpRuntimeNamingPublication": "#/$defs/McpRuntimeNamingPublication",
    "McpMigrationMarker": "#/$defs/McpMigrationMarker"
  },
  "$defs": {
    "SchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "McpId": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "McpVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Case-sensitive exact MCP Version. Historical non-SemVer values remain valid exact identities."
    },
    "SemVer": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
    },
    "VersionRange": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "anyOf": [
        {
          "pattern": "^\\[(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?\\]$"
        },
        {
          "pattern": "^(?:\\[|\\()(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?,(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\]|\\))$"
        },
        {
          "pattern": "^(?:\\[|\\()(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?,\\)$"
        },
        {
          "pattern": "^\\(,(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\]|\\))$"
        }
      ],
      "description": "Canonical Agent/RAD Version range syntax. Domain validation must also verify bound order, canonical spelling, and that the range contains the runtime Version."
    },
    "ServerStorageKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^:]+:mcp-server:.+-mcp-server\\.json$",
      "description": "The built-in provider splits only the first two colons and treats the remainder as the Config data id."
    },
    "ToolStorageKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^:]+:mcp-tools:.+-mcp-tools\\.json$"
    },
    "ResourceStorageKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^:]+:mcp-resources:.+-mcp-resources\\.json$"
    },
    "McpVersionStorageDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "keyFormat",
        "serverKey",
        "schemaVersion"
      ],
      "properties": {
        "provider": {
          "const": "nacos_config"
        },
        "keyFormat": {
          "const": "mcp-config-v1"
        },
        "serverKey": {
          "$ref": "#/$defs/ServerStorageKey"
        },
        "toolKey": {
          "$ref": "#/$defs/ToolStorageKey"
        },
        "resourceKey": {
          "$ref": "#/$defs/ResourceStorageKey"
        },
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "description": "Points to the existing three MCP Config objects without copying their bytes. serverKey is required; optional content keys are omitted rather than serialized as null."
    },
    "EndpointKind": {
      "type": "string",
      "enum": [
        "DIRECT",
        "SERVICE_REF",
        "RUNTIME_REF"
      ]
    },
    "TransportProtocol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9+._-]{0,63}$"
    },
    "McpDirectEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "port",
        "transportProtocol"
      ],
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "transportProtocol": {
          "$ref": "#/$defs/TransportProtocol"
        }
      }
    },
    "McpDirectEndpointSnapshot": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/McpDirectEndpoint"
      },
      "description": "Complete Direct Endpoint snapshot. Domain projection deduplicates by address, numeric port, and transportProtocol, then sorts by address UTF-16 ordinal, numeric port, and transportProtocol UTF-16 ordinal. JSON Schema cannot enforce that order."
    },
    "McpServerStorageExtension": {
      "type": "object",
      "required": [
        "endpointKind"
      ],
      "properties": {
        "endpointKind": {
          "$ref": "#/$defs/EndpointKind"
        },
        "directEndpoints": {
          "$ref": "#/$defs/McpDirectEndpointSnapshot"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "endpointKind": {
                "const": "DIRECT"
              }
            },
            "required": [
              "endpointKind"
            ]
          },
          "then": {
            "required": [
              "directEndpoints"
            ]
          },
          "else": {
            "not": {
              "required": [
                "directEndpoints"
              ]
            }
          }
        }
      ],
      "description": "Extension fields embedded in the existing McpServerStorageInfo JSON. Other historical Server fields remain open and unchanged. Newly written content requires an explicit kind; migrated historical non-Direct content may retain its old bytes and use compatibility inference."
    },
    "SnapshotDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of the UTF-8 common-Nacos-JSON serialization of the sorted and deduplicated Direct snapshot. Each object emits address, port, transportProtocol in that order and no other property."
    },
    "McpDirectProjectionMetadata": {
      "type": "object",
      "required": [
        "__nacos.ai.mcp.service__",
        "__nacos.ai.mcp.id__",
        "__nacos.ai.mcp.version__",
        "__nacos.ai.mcp.endpointSnapshotHash__"
      ],
      "properties": {
        "__nacos.ai.mcp.service__": {
          "const": "true"
        },
        "__nacos.ai.mcp.id__": {
          "$ref": "#/$defs/McpId"
        },
        "__nacos.ai.mcp.version__": {
          "$ref": "#/$defs/McpVersion"
        },
        "__nacos.ai.mcp.endpointSnapshotHash__": {
          "$ref": "#/$defs/SnapshotDigest"
        }
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "A projection update or delete must match all four owner fields and the expected digest. Merely finding the historical Direct mark is insufficient."
    },
    "SupportedTransports": {
      "type": "string",
      "enum": [
        "sse",
        "streamable-http",
        "sse,streamable-http"
      ]
    },
    "McpRuntimeEndpointMetadata": {
      "type": "object",
      "properties": {
        "__nacos.mcp.endpoint.supportedTransports__": {
          "$ref": "#/$defs/SupportedTransports"
        },
        "__nacos.mcp.endpoint.version__": {
          "$ref": "#/$defs/McpVersion"
        },
        "__nacos.mcp.endpoint.versionRange__": {
          "$ref": "#/$defs/VersionRange"
        },
        "_mcp_server_version": {
          "$ref": "#/$defs/McpVersion",
          "description": "Legacy exact-Version compatibility key. It is read only when the new Version key is absent."
        }
      },
      "additionalProperties": {
        "type": "string"
      },
      "allOf": [
        {
          "if": {
            "required": [
              "__nacos.mcp.endpoint.versionRange__"
            ]
          },
          "then": {
            "required": [
              "__nacos.mcp.endpoint.version__"
            ],
            "properties": {
              "__nacos.mcp.endpoint.version__": {
                "$ref": "#/$defs/SemVer"
              }
            }
          }
        }
      ],
      "description": "No new Version key and no range means all-Version compatibility. A new Version without a range is exact, including non-SemVer. A range requires a SemVer runtime Version and must contain it. No versionBindings array is stored."
    },
    "McpRuntimeNamingPublication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "namespaceId",
        "groupName",
        "serviceName",
        "clusterName",
        "ip",
        "port",
        "ephemeral",
        "enabled",
        "healthy",
        "metadata"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "namespaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "groupName": {
          "const": "mcp-endpoints"
        },
        "serviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Exactly the case-sensitive mcpName. Version, protocol, and transport are not composed into it."
        },
        "clusterName": {
          "const": "DEFAULT"
        },
        "ip": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "ephemeral": {
          "const": true
        },
        "enabled": {
          "type": "boolean"
        },
        "healthy": {
          "type": "boolean"
        },
        "metadata": {
          "$ref": "#/$defs/McpRuntimeEndpointMetadata"
        }
      },
      "description": "Target Versionless MCP Runtime Naming publication. Historical mcpName::version Services remain outside this entry point and are read only by the compatibility merge."
    },
    "McpMigrationMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "state",
        "completedAt"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "state": {
          "const": "CANONICAL"
        },
        "completedAt": {
          "type": "integer",
          "minimum": 0,
          "description": "Unix epoch time in milliseconds."
        }
      },
      "description": "Permanent one-way completion marker. SYNCING is represented by marker absence; failure or retry does not publish another state and CANONICAL is never rolled back automatically."
    }
  }
}
